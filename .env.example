# Copy to .env.local and fill in. Everything here is read on the server only.

# Optional: set the sign-in passcode here instead of on the first-run screen. Use a long phrase.
APP_PASSCODE=
# Optional: random 32+ character string to sign session cookies (otherwise generated and stored in the database).
SESSION_SECRET=

# Database. Leave empty to use the embedded Postgres (PGlite) stored in ./.data
# Set to a Supabase/Postgres connection string to use a hosted database.
DATABASE_URL=

# Anthropic API key: enables the assistant, online recipe discovery,
# natural-language and photo meal logging, receipt reading and AI recipe edits.
ANTHROPIC_API_KEY=

# Timezone used to decide what "today" is (default Africa/Cairo).
APP_TIMEZONE=

# Optional: where the embedded database lives when DATABASE_URL is not set (default ./.data/pg)
MISE_DATA_DIR=
